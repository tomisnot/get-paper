{
  "name": "paperpilot-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh (Cordis) plugin for PaperPilot: takes over the MCP connection lifecycle (self-healing reconnect past dsh's streamable-http dead-zone) and surfaces the read-only AI-monitor tab in the right sidebar.",
  "main": "lib/index.mjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --preserve-symlinks --import tsx test/run.ts && npm run test:panel",
    "test:panel": "node --preserve-symlinks --import tsx --test test/panel.test.ts",
    "bundle": "tsdown"
  },
  "dependencies": {
    "@mecha/dsh-panel": "file:../../../../../../../code-nosync/mecha/mecha/dsh-panel",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.1",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-brand": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  }
}
