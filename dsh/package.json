{
  "name": "paperpilot-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh (Cordis) plugin for PaperPilot. ⭐ 2026-10-10 起本包只有**面板**那一件事：client 半是框架面板插件的一行 bootstrap；host 半是**空载体**（工具面只有一条腿 = 框架的聚合端点，自愈 MCP 桥已删除）。",
  "main": "lib/index.mjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/panel.test.ts",
    "bundle": "tsdown"
  },
  "dependencies": {},
  "devDependencies": {
    "@mecha/dsh-panel": "file:../../../../../../../code-nosync/mecha/mecha/dsh-panel",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true }
  }
}
