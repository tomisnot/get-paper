.venv/
__pycache__/
*.pyc
.pytest_cache/
data/
config/settings.json

# 端点发现的端口文件（framework 读它们，内容是运行时端口）
.mcp-port
.cockpit-port
.control-port
.mecha/

# vendored 布局引擎（Graphviz ~20MB 的 exe+dll）：由 scripts/fetch_graphviz.ps1 现取，不入库
vendor/

# 统一启动器写在启动目录下的运行期产物（pid / 日志）
_mecha_runtime/

# 工具缓存
.ruff_cache/

# 打包生成的元数据（pip install -e 每次重写）
*.egg-info/
