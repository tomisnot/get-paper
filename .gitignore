# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# 运行时数据（SQLite / PDF 缓存 / 日志 / 备份）
data/*.sqlite3
data/*.db
data/cache/
data/logs/
backups/
*.sqlite3
*.db

# 环境
.env
.pytest_cache/
.ruff_cache/

# 本地真配置（**不进仓**；发布的是 config/settings.example.yaml）
# ⚠ 里面有自己的数据目录/主题/key ⇒ 只在本机存在；缺它时程序回落到 example（见 config.py::load_settings）
config/settings.yaml

# DSH 插件（node 生态）
dsh/node_modules/
dsh/lib/
.mcp-port
.cockpit-port
# Web 端口发现文件（dsh 面板的地址来源；运行期状态，每次启动重写）
.web-port

# 运行时数据（补充：下载 PDF / 生成简报 / 评审中间态 / mecha journal+artifacts）
data/
data/pdfs/
data/briefings/
data/reviews/
data/mecha/
*.pkl

# IDE / 工具本地
.qoder/

tests/

# 统一启动器的运行期产物（pid / 日志）：每台机器各自生成，不入库。
# ⚠ 由框架 `mecha/launch.py` 写在「启动时的 cwd」下；含本机 pid。
_mecha_runtime/
